# Backend environment. Copy to backend/.env for local development; set the same
# variables in the Railway service for the deployment.

# --- Database -------------------------------------------------------------
# Path to a local names.db. `make sample-db` builds a small one for dev.
NAMES_DB_PATH=data/sample_names.db
# Hugging Face dataset to download the database from when no local copy exists.
# Deliberately left unset in production: the image bakes the database in, so the
# running container never calls a third party.
# NAMES_DB_REPO=
# NAMES_DB_FILE=names.db
# NAMES_DB_REPO_TYPE=dataset
# HF_TOKEN=

# --- Chatbot --------------------------------------------------------------
# Without a key the chat endpoints answer "chatbot unavailable" rather than
# failing at startup.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# --- Gateway --------------------------------------------------------------
# Required on every endpoint except /api/health. Must match the frontend's
# BACKEND_SHARED_SECRET exactly — drift between the two fails every request.
# Generate one with: openssl rand -hex 32
#
# Leave it unset locally and the backend requires no secret, so a fresh checkout
# runs with no setup. A *deployed* backend with no secret refuses every request
# instead (see docs/adr/0002-shared-secret-gateway.md).
BACKEND_SHARED_SECRET=

# "development" or "production". Set to production wherever the backend is
# publicly reachable; on Railway this is also inferred from the platform's own
# variables, so a forgotten value cannot leave the backend unguarded.
APP_ENV=development

# CORS origins. Defence in depth only — no browser ever calls this backend
# directly, so this is not what guards it.
ALLOWED_ORIGINS=http://localhost:3000
