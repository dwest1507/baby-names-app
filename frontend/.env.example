# Frontend environment. Copy to frontend/.env.local for local development; set
# the same variables in the Vercel project for the deployment.
#
# Neither variable has a NEXT_PUBLIC_ prefix, and neither may ever gain one:
# both are read only in the server-side proxy at app/api/[...path]/route.ts, so
# the browser learns neither the backend's URL nor the secret.

# Where the proxy forwards /api/* calls.
NAMES_API_URL=http://localhost:8000

# Must match the backend's BACKEND_SHARED_SECRET exactly. Leave unset locally to
# run against a backend that has no secret configured.
BACKEND_SHARED_SECRET=
